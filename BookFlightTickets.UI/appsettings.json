{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "ConnectionStrings": {
    "CS": "YOUR_CONNECTION_SETINGS_CS",
    "Redis": "YOUR_CONNECTION_SETINGS_REDIS"
  },
  "AllowedHosts": "*",
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECREY_KEY",
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY"
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_AYTHENTICATION_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_AYTHENTICATION_GOOGLE_CLIENT_SECRET"
    }
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Flight Booking Team",
    "SenderEmail": "YOUR_EMAIL_SETTINGS_SENDER_EMAIL",
    "Password": "YOUR_EMAIL_SETTINGS_PASSWORD"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}